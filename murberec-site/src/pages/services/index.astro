---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import SectionHead from '../../components/SectionHead.astro';
import { services, approach } from '../../data/services';
const crumbs = [{ name: 'Services', path: '/services' }];
---
<Base
  title="Consulting Services: Leadership, Learning, Change & Product"
  description="Four disciplines, one approach. MURBEREC® designs leadership development, learning experiences, change management and products around how people actually think and change."
  crumbs={crumbs}
>
  <PageHero crumbs={crumbs} kicker="Services" title="Four disciplines.<br/><span class='muted'>One way of seeing people.</span>"
    lede="Whatever the brief, we start from the same place: how people pay attention, learn, decide and form habits. Then we build something that fits your organization, not a template." />

  <section class="section" aria-labelledby="svc-list">
    <div class="wrap">
      <SectionHead num={1} label="Disciplines" />
      <h2 id="svc-list" class="sr-only">Our disciplines</h2>
      <ul class="card-list">
        {services.map((s, i) => (
          <li class="reveal">
            <a class="row-card" href={`/services/${s.slug}`}>
              <span class="mono muted">0{i + 1}</span>
              <span>
                <h3 class="row-card__title">{s.title}</h3>
                <p class="row-card__body muted">{s.summary}</p>
              </span>
              <span class="row-card__go" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section light" aria-labelledby="svc-method">
    <div class="wrap">
      <SectionHead num={2} label="How every engagement runs" />
      <h2 id="svc-method" class="h2">Diagnose. Design. <span class="accent">Embed.</span></h2>
      <ol class="method">
        {approach.map((a, i) => (
          <li><p class="mono accent">0{i + 1}</p><h3 class="h3">{a.step}</h3><p class="muted">{a.body}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <CtaBand where="services" />
</Base>
<style>
  .method { list-style: none; display: grid; gap: var(--space-l); margin-top: var(--space-xl); }
  .method li { display: grid; gap: var(--space-s); border-top: 1px solid currentColor; padding-top: var(--space-m); }
  @media (min-width: 56rem) { .method { grid-template-columns: repeat(3, 1fr); } }
</style>
