---
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((item, i) => (
    <details open={i === 0}>
      <summary><h3 class="faq__q">{item.q}</h3></summary>
      <p class="answer muted">{item.a}</p>
    </details>
  ))}
</div>
<style>
  .faq__q { font: inherit; letter-spacing: inherit; line-height: 1.3; min-width: 0; overflow-wrap: anywhere; }
</style>
